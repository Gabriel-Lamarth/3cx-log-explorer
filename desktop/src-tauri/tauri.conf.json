{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3CX Log Explorer",
  "version": "0.3.0",
  "identifier": "dev.local.threecx-log-explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "3CX Log Explorer",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Análise local de logs 3CX",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
